<Window x:Class="ProductManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductManagement"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1200">
    <Grid Margin="10">
        <!--Header-->
        <Border Background=" " Height="60" VerticalAlignment="Top" CornerRadius="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="Product Management Dashboard" Foreground="White" FontSize="24" FontWeight="Bold"></TextBlock>
                <Button Content="Logout" Background=" " Foreground="White" Width="80" Height="30" HorizontalAlignment="Right" Margin="500,0,0,"Cursor="Hand"
            </StackPanel>
        </Border>
            
        <!-- Product List-->
        <GroupBox Header="Products" Margin="10,80,10,230" FontWeight="Bold"/>
        <DataGrid Name="ProductGrid" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" RowBackground="WhiteSmoke" AlternatingRowBackground="#ecfof1"/>
        </GroupBox>
        
        <!--Add/Edit Product Form-->

        <GroupBox Header="Add/Edit Product" Margin="10,420,10,10" FontWeight="Bold">
            <Grid Margin=" "
            
            
            
            
            
            
            
        </GroupBox> 






    </Grid>
</Window>
