<Window x:Class="ProductManagement.Login.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductManagement.Login"
        mc:Ignorable="d"
        Title="Register" Height="800" Width="800">
    <Grid>
        <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Register" Style="{StaticResource TextTitle}"></TextBlock>
             <!-- Full Name-->
                
                <TextBlock Text="Full Name" Margin="0,0,0,5"></TextBlock>
                <TextBox x:Name="txtusername" Height="30"></TextBox>
                
             <!-- Email-->
                
                <TextBlock Text="Email" Margin="0,0,0,5"></TextBlock>
                <TextBox x:Name="txtemail" Height="30"></TextBox>
                
                <!--Password-->
                <TextBlock Text="Password" Margin="0,0,0,5"></TextBlock>
                <PasswordBox x:Name="pwpassword" Height="30"></PasswordBox>
                
                <!--Confirm Password-->
                <TextBlock Text="Confirm Password" Margin="0,0,0,5"></TextBlock>
                <PasswordBox x:Name="pwcpassword" Height="30"></PasswordBox>
                
                <!--Gender-->
                <TextBlock  Text="Gender" Margin="0,0,0,5"></TextBlock>
                <StackPanel Orientation="Horizontal" Height="30">
                    <RadioButton Content="Male" Margin="0,0,20,0"></RadioButton>
                    <RadioButton Content="Female" Margin="0,0,20,0"></RadioButton>
                    <RadioButton Content="Other" Margin="0,0,20,0"></RadioButton>
                </StackPanel>
                
             <!--Date of Birth (DatePicker)-->
                
                <TextBlock Text="Date of Birth" Margin="0,0,0,5"></TextBlock>
                <DatePicker Height="30"></DatePicker>
                
                <!--Country (ComboBox)-->
                
                <TextBlock Text="Country" Margin="0,0,0,5"></TextBlock>
                <ComboBox Height="30">
                    <ComboBoxItem Content="India"></ComboBoxItem>
                    <ComboBoxItem Content="USA"></ComboBoxItem>
                    <ComboBoxItem Content="Germany"></ComboBoxItem>
                    <ComboBoxItem Content="China"></ComboBoxItem>
                    <ComboBoxItem Content="Other"></ComboBoxItem>
                </ComboBox>
                
                <!--Interests(ListBox)-->
                
                <TextBlock Text="Interests" Margin="0,0,0,5"></TextBlock>
                <ListBox Height="30" SelectionMode="Extended">
                    <ListBoxItem Content="Dance"></ListBoxItem>
                    <ListBoxItem Content="Music"></ListBoxItem>
                    <ListBoxItem Content="Technology"></ListBoxItem>
                    <ListBoxItem Content="Sports"></ListBoxItem>
                    <ListBoxItem Content="Art"></ListBoxItem>
                </ListBox>
                           
             <!--Terms and Conditions (CheckBox)-->
                <CheckBox Content="I accept Terms Conditions" Margin="0,10,0,0"></CheckBox>
                          
             <!--Register Button-->   
                    
                <Button Content="Register" x:Name="btnreg" Click="btnreg_Click" FontWeight="SemiBold" FontSize="18" Margin="20" Height="30"></Button>
              
            <!--Login Link--> 
                    
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="already have an account?" FontSize="13" Margin="290,0,0,0"></TextBlock> 
                    <Button Content="Login" x:Name="btnlogin" Click="btnlogin_Click" FontSize="13" Style="{StaticResource linkButton}"></Button>

                </StackPanel>
                







            </StackPanel>
        </Border>
        
    </Grid>
</Window>
