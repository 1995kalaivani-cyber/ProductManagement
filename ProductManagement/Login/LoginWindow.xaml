<Window x:Class="ProductManagement.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductManagement.Login"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid>
        <Border Background="White" CornerRadius="10" Padding="20" Margin="30">
            <StackPanel Background="">
                <TextBlock Text="Login" Margin="0,0,0,20" Style="{StaticResource TextTitle}"/>
                <TextBlock Text="User Name" Margin="0,0,0,5" FontSize="14" FontWeight="SemiBold"/>
                <TextBox x:Name="txtusername" Height="30"/>
                <TextBlock Text="Password" Margin="0,10,0,5" FontSize="14" FontWeight="SemiBold"/>
                <PasswordBox x:Name="pwpassword" Height="30"/>
                <Button Content="Login" x:Name="btnlogin" Click="btnlogin_Click" FontWeight="SemiBold" FontSize="18" Margin="30" Height="30" ></Button>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Don't have an account?" Margin="250,5,5,5" FontSize="13"/>
                    <Button Content="Register" x:Name="btnreg" Click="btnreg_Click" FontSize="13" Style ="{StaticResource linkButton}"></Button>
                </StackPanel>
                
            </StackPanel>
            </Border> 
     </Grid>
</Window>
